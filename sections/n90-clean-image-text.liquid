<section class="section{% if section.settings.background == 'soft' %} soft-band{% elsif section.settings.background == 'dark' %} dark-band{% endif %}"{% if section.settings.anchor != blank %} id="{{ section.settings.anchor | handleize }}"{% endif %}><div class="wrap image-text{% if section.settings.reverse %} image-text-reverse{% endif %}"><div class="image-text-media">{% if section.settings.image != blank %}{{ section.settings.image | image_url: width: 1400 | image_tag: loading: 'lazy', widths: '400,700,1000,1400', sizes: '(max-width:749px) 100vw, 50vw' }}{% else %}<img src="{{ section.settings.artwork | asset_url }}" width="840" height="720" alt="{{ section.settings.image_alt | escape }}" loading="lazy">{% endif %}<span class="media-corner">{{ section.settings.caption | escape }}</span></div><div class="image-text-copy"><span class="eyebrow">{{ section.settings.eyebrow | escape }}</span><h2 class="d h2">{{ section.settings.heading | escape }}</h2><div class="rte lead">{{ section.settings.text }}</div>{% if section.settings.button_label != blank %}<a class="btn" href="{{ section.settings.button_link | default: routes.all_products_collection_url }}">{{ section.settings.button_label | escape }} {% render 'n90-clean-icon', name: 'arrow' %}</a>{% endif %}</div></div></section>

{% schema %}
{
  "name": "Image with text",
  "settings": [
    {
      "type": "text",
      "id": "eyebrow",
      "label": "Eyebrow",
      "default": "Match day ready"
    },
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "One team. One identity."
    },
    {
      "type": "richtext",
      "id": "text",
      "label": "Text",
      "default": "<p>Bring your team together with a look that works on and off the pitch.</p>"
    },
    {
      "type": "image_picker",
      "id": "image",
      "label": "Image"
    },
    {
      "type": "select",
      "id": "artwork",
      "label": "Fallback illustration",
      "options": [
        {
          "value": "nn-teamwear.svg",
          "label": "Teamwear"
        },
        {
          "value": "nn-training.svg",
          "label": "Training"
        },
        {
          "value": "nn-hero-kit.svg",
          "label": "Kit lineup"
        },
        {
          "value": "nn-accessories.svg",
          "label": "Equipment"
        }
      ],
      "default": "nn-teamwear.svg"
    },
    {
      "type": "text",
      "id": "image_alt",
      "label": "Illustration description",
      "default": "Nineties90 teamwear illustration"
    },
    {
      "type": "text",
      "id": "caption",
      "label": "Image caption",
      "default": "NINETIES90 / MATCH DAY"
    },
    {
      "type": "text",
      "id": "button_label",
      "label": "Button label",
      "default": "Explore the collection"
    },
    {
      "type": "url",
      "id": "button_link",
      "label": "Button link"
    },
    {
      "type": "select",
      "id": "background",
      "label": "Background",
      "options": [
        {
          "value": "white",
          "label": "White"
        },
        {
          "value": "soft",
          "label": "Soft grey"
        },
        {
          "value": "dark",
          "label": "Navy"
        }
      ],
      "default": "white"
    },
    {
      "type": "checkbox",
      "id": "reverse",
      "label": "Image on the right",
      "default": false
    },
    {
      "type": "text",
      "id": "anchor",
      "label": "Section anchor"
    }
  ],
  "presets": [
    {
      "name": "Image with text"
    }
  ],
  "class": "n90-clean"
}
{% endschema %}
