{% if section.settings.text != blank or section.settings.text_2 != blank or section.settings.text_3 != blank %}
<div class="announcement ref-announcement" data-announcement><div class="ref-announcement-inner">
{% assign ids = 'text,text_2,text_3' | split: ',' %}{% for key in ids %}{% if section.settings[key] != blank %}<span data-announcement-item>{% if section.settings.link != blank %}<a href="{{ section.settings.link }}">{% endif %}{{ section.settings[key] | escape }}{% if section.settings.link != blank %}</a>{% endif %}</span>{% endif %}{% endfor %}
</div></div>{% endif %}
{% schema %}
{
  "name": "Announcement bar",
  "class": "n90-clean",
  "settings": [
    {
      "type": "text",
      "id": "text",
      "label": "First message",
      "default": "Free UK shipping over £50"
    },
    {
      "type": "text",
      "id": "text_2",
      "label": "Second message",
      "default": "10% off your first order: NINETIES10"
    },
    {
      "type": "text",
      "id": "text_3",
      "label": "Third message"
    },
    {
      "type": "url",
      "id": "link",
      "label": "Link"
    }
  ]
}
{% endschema %}
