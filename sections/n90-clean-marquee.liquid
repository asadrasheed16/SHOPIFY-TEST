<div class="brand-marquee" aria-label="{{ section.settings.text | escape }}"><div class="marquee-track" aria-hidden="true">{% for i in (1..8) %}<span>{{ section.settings.text | escape }} <span class="marquee-star">✳</span></span>{% endfor %}</div></div>

{% schema %}
{
  "name": "Brand marquee",
  "settings": [
    {
      "type": "text",
      "id": "text",
      "label": "Text",
      "default": "Your colours. Your club. Your game."
    }
  ],
  "presets": [
    {
      "name": "Brand marquee"
    }
  ],
  "class": "n90-clean"
}
{% endschema %}
