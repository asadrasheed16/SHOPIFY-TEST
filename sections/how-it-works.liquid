{%- comment -%}
  sections/how-it-works.liquid
  Nineties90 — Direction C "Clean Sport · Motion"
  Source: <section class="sec" data-section="HowItWorks">
{%- endcomment -%}

{%- liquid
  assign bg       = section.settings.color_background
  assign ink      = section.settings.color_text
  assign muted    = section.settings.color_muted
  assign accent   = section.settings.color_accent
  assign line_col = section.settings.color_line
  assign surface  = section.settings.color_surface
  assign pt       = section.settings.padding_top
  assign pb       = section.settings.padding_bottom
-%}

{%- style -%}
  #shopify-section-{{ section.id }} {
    --hiw-bg:      {{ bg }};
    --hiw-ink:     {{ ink }};
    --hiw-muted:   {{ muted }};
    --hiw-accent:  {{ accent }};
    --hiw-line:    {{ line_col }};
    --hiw-surface: {{ surface }};
    --hiw-ease:    cubic-bezier(.2,.7,.2,1);
  }

  .n90-hiw {
    padding-top: {{ pt }}px;
    padding-bottom: {{ pb }}px;
    background: var(--hiw-bg);
    color: var(--hiw-ink);
  }

  /* ── Header ──────────────────────────────────────────────────────── */
  .n90-hiw__head {
    display: flex;
    justify-content: space-between;
    align-items: flex-end;
    gap: 24px;
    margin-bottom: 48px;
  }
  .n90-hiw__eyebrow {
    font-family: 'Barlow Condensed', 'Arial Narrow', sans-serif;
    font-size: 14px;
    font-weight: 600;
    text-transform: uppercase;
    letter-spacing: .18em;
    color: var(--hiw-ink);
    margin-bottom: 16px;
  }
  .n90-hiw__heading {
    font-family: 'Barlow Condensed', 'Arial Narrow', sans-serif;
    font-size: clamp(32px, 3.6vw, 54px);
    font-weight: 600;
    text-transform: uppercase;
    letter-spacing: .01em;
    line-height: 1.1;
    margin: 0;
    color: var(--hiw-ink);
  }
  .n90-hiw__subtext {
    font-size: 16px;
    color: var(--hiw-muted);
    margin-top: 12px;
    max-width: 600px;
  }
  
  .n90-hiw__btn {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    gap: 8px;
    min-height: 52px;
    padding: 0 28px;
    background: var(--hiw-ink);
    color: var(--hiw-bg);
    font-family: 'Barlow Condensed', 'Arial Narrow', sans-serif;
    font-size: 17px;
    font-weight: 600;
    text-transform: uppercase;
    letter-spacing: .07em;
    border-radius: 4px;
    text-decoration: none;
    transition: opacity .2s;
    white-space: nowrap;
    flex-shrink: 0;
  }
  .n90-hiw__btn:hover { opacity: .86; }

  /* ── Grid ────────────────────────────────────────────────────────── */
  .n90-hiw__grid {
    display: grid;
    grid-template-columns: repeat(4, minmax(0, 1fr));
    gap: 24px;
  }

  /* ── Step Card ───────────────────────────────────────────────────── */
  .n90-hiw__card {
    display: flex;
    flex-direction: column;
    background: var(--hiw-bg);
    border: 1px solid var(--hiw-line);
    border-radius: 8px;
    padding: 32px 24px;
    position: relative;
    transition: transform .3s var(--hiw-ease), box-shadow .3s var(--hiw-ease);
  }
  .n90-hiw__card:hover {
    transform: translateY(-4px);
    box-shadow: 0 12px 24px rgba(0,0,0,0.04);
  }

  .n90-hiw__card-top {
    display: flex;
    justify-content: space-between;
    align-items: flex-start;
    margin-bottom: 24px;
  }

  .n90-hiw__num {
    font-family: 'Barlow Condensed', 'Arial Narrow', sans-serif;
    font-size: 56px;
    line-height: 1;
    font-weight: 600;
    color: var(--hiw-ink);
  }

  .n90-hiw__icon {
    width: 48px;
    height: 48px;
    border-radius: 50%;
    background: var(--hiw-surface);
    display: flex;
    align-items: center;
    justify-content: center;
    color: var(--hiw-ink);
    overflow: hidden;
  }
  .n90-hiw__icon img {
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  .n90-hiw__badge {
    display: inline-flex;
    align-items: center;
    padding: 4px 10px;
    background: var(--hiw-surface);
    color: var(--hiw-ink);
    font-size: 12px;
    font-weight: 600;
    border-radius: 99px;
    margin-bottom: 16px;
    align-self: flex-start;
    letter-spacing: .02em;
  }

  .n90-hiw__title {
    font-family: 'Barlow Condensed', 'Arial Narrow', sans-serif;
    font-size: 24px;
    font-weight: 600;
    text-transform: uppercase;
    letter-spacing: .02em;
    line-height: 1.2;
    margin: 0 0 8px;
    color: var(--hiw-ink);
  }

  .n90-hiw__desc {
    font-size: 14px;
    color: var(--hiw-muted);
    line-height: 1.5;
    margin: 0;
  }

  /* ── Responsive ──────────────────────────────────────────────────── */
  @media screen and (max-width: 1023px) {
    .n90-hiw__grid { grid-template-columns: repeat(2, minmax(0, 1fr)); }
  }
  @media screen and (max-width: 749px) {
    .n90-hiw { padding-top: {{ pt | at_most: 64 }}px; padding-bottom: {{ pb | at_most: 64 }}px; }
    .n90-hiw__head { flex-direction: column; align-items: flex-start; gap: 20px; margin-bottom: 32px; }
    .n90-hiw__grid { grid-template-columns: 1fr; gap: 16px; }
    .n90-hiw__card { padding: 24px; }
    .n90-hiw__num { font-size: 44px; }
  }
{%- endstyle -%}

<section class="n90-hiw" id="n90-hiw-{{ section.id }}" data-section="HowItWorks">
  <div class="page-width">
    <div class="n90-hiw__head">
      <div>
        {%- if section.settings.eyebrow != blank -%}
          <p class="n90-hiw__eyebrow">{{ section.settings.eyebrow | escape }}</p>
        {%- endif -%}
        {%- if section.settings.heading != blank -%}
          <h2 class="n90-hiw__heading">{{ section.settings.heading | escape }}</h2>
        {%- endif -%}
        {%- if section.settings.subtext != blank -%}
          <div class="n90-hiw__subtext">{{ section.settings.subtext }}</div>
        {%- endif -%}
      </div>
      {%- if section.settings.btn_label != blank -%}
        <a href="{{ section.settings.btn_url | default: '#' }}" class="n90-hiw__btn">
          {{- section.settings.btn_label | escape -}}
        </a>
      {%- endif -%}
    </div>

    {%- if section.blocks.size > 0 -%}
      <div class="n90-hiw__grid">
        {%- for block in section.blocks -%}
          <div class="n90-hiw__card" {{ block.shopify_attributes }}>
            <div class="n90-hiw__card-top">
              <span class="n90-hiw__num">{{ block.settings.step_num | escape }}</span>
              {%- if block.settings.icon_image != blank -%}
                <div class="n90-hiw__icon">
                  {{ block.settings.icon_image | image_url: width: 96 | image_tag: loading: 'lazy', alt: block.settings.icon_image.alt }}
                </div>
              {%- endif -%}
            </div>
            
            {%- if block.settings.badge != blank -%}
              <span class="n90-hiw__badge">{{ block.settings.badge | escape }}</span>
            {%- endif -%}

            {%- if block.settings.title != blank -%}
              <h3 class="n90-hiw__title">{{ block.settings.title | escape }}</h3>
            {%- endif -%}

            {%- if block.settings.description != blank -%}
              <div class="n90-hiw__desc">{{ block.settings.description }}</div>
            {%- endif -%}
          </div>
        {%- endfor -%}
      </div>
    {%- endif -%}
  </div>
</section>

{% schema %}
{
  "name": "How It Works",
  "tag": "section",
  "class": "section-how-it-works",
  "disabled_on": { "groups": ["header", "footer"] },
  "settings": [
    { "type": "header", "content": "Colour scheme" },
    { "type": "color", "id": "color_background", "label": "Section background", "default": "#F3F5F8" },
    { "type": "color", "id": "color_text",    "label": "Text / ink",       "default": "#0E1B33" },
    { "type": "color", "id": "color_muted",   "label": "Muted text",       "default": "#4A5568" },
    { "type": "color", "id": "color_accent",  "label": "Accent",           "default": "#D4FF3A" },
    { "type": "color", "id": "color_line",    "label": "Border / divider", "default": "#E2E6ED" },
    { "type": "color", "id": "color_surface", "label": "Card background",  "default": "#FFFFFF" },
    { "type": "header", "content": "Spacing" },
    {
      "type": "range", "id": "padding_top", "label": "Padding top",
      "min": 0, "max": 200, "step": 8, "unit": "px", "default": 112
    },
    {
      "type": "range", "id": "padding_bottom", "label": "Padding bottom",
      "min": 0, "max": 200, "step": 8, "unit": "px", "default": 112
    },
    { "type": "header", "content": "Section header" },
    {
      "type": "text", "id": "eyebrow", "label": "Eyebrow",
      "default": "How it works"
    },
    {
      "type": "text", "id": "heading", "label": "Heading",
      "default": "From pitch to production in 4 steps"
    },
    {
      "type": "richtext", "id": "subtext", "label": "Subtext",
      "default": "<p>A simple, transparent process to get your club match-ready.</p>"
    },
    { "type": "header", "content": "Call to action" },
    {
      "type": "text", "id": "btn_label", "label": "Button label",
      "default": "Start your design"
    },
    { "type": "url", "id": "btn_url", "label": "Button URL" }
  ],
  "blocks": [
    {
      "type": "step",
      "name": "Step",
      "limit": 8,
      "settings": [
        {
          "type": "text", "id": "step_num", "label": "Step number",
          "default": "01",
          "info": "Oversized Barlow Condensed numeral."
        },
        {
          "type": "text", "id": "title", "label": "Title",
          "default": "Design"
        },
        {
          "type": "richtext", "id": "description", "label": "Description",
          "default": "<p>Use our 3D kit builder or let our design team create concepts for you.</p>"
        },
        {
          "type": "text", "id": "badge", "label": "Pill badge",
          "default": "Free mockups",
          "info": "Optional small tag above the title."
        },
        {
          "type": "image_picker", "id": "icon_image", "label": "Custom icon"
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "How It Works",
      "blocks": [
        {
          "type": "step",
          "settings": {
            "step_num": "01",
            "title": "Design",
            "description": "<p>Build your kit in 3D or get free custom concepts from our design team.</p>",
            "badge": "Free mockups"
          }
        },
        {
          "type": "step",
          "settings": {
            "step_num": "02",
            "title": "Approve",
            "description": "<p>Review your digital samples, sign off on the artwork and confirm your club order.</p>",
            "badge": "No obligation"
          }
        },
        {
          "type": "step",
          "settings": {
            "step_num": "03",
            "title": "Produce",
            "description": "<p>Your kit goes into our state-of-the-art sublimation production line.</p>",
            "badge": "3–4 weeks"
          }
        },
        {
          "type": "step",
          "settings": {
            "step_num": "04",
            "title": "Deliver",
            "description": "<p>Fully tracked courier delivery straight to your clubhouse or club secretary.</p>",
            "badge": "Tracked delivery"
          }
        }
      ]
    }
  ]
}
{% endschema %}
