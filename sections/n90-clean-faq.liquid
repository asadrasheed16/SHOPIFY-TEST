<section class="section"><div class="wrap faq-layout"><div><span class="eyebrow">{{ section.settings.eyebrow | escape }}</span><h2 class="d h2">{{ section.settings.heading | escape }}</h2><p class="muted">{{ section.settings.text | escape }}</p></div><div>{% for block in section.blocks %}<details class="faq-item" {{ block.shopify_attributes }}><summary><span>{{ block.settings.question | escape }}</span><span class="faq-plus" aria-hidden="true">+</span></summary><div class="rte">{{ block.settings.answer }}</div></details>{% endfor %}</div></div></section>

{% schema %}
{
  "name": "FAQ",
  "settings": [
    {
      "type": "text",
      "id": "eyebrow",
      "label": "Eyebrow",
      "default": "Good to know"
    },
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "Your questions, answered"
    },
    {
      "type": "textarea",
      "id": "text",
      "label": "Introduction",
      "default": "Need help choosing your kit? Tell us about your team."
    }
  ],
  "blocks": [
    {
      "type": "question",
      "name": "Question",
      "settings": [
        {
          "type": "text",
          "id": "question",
          "label": "Question",
          "default": "How do I get a teamwear quote?"
        },
        {
          "type": "richtext",
          "id": "answer",
          "label": "Answer",
          "default": "<p>Use our team quote form to share your sport, team size and preferred colours. We’ll get back to you with the next steps.</p>"
        }
      ]
    }
  ],
  "max_blocks": 12,
  "presets": [
    {
      "name": "Frequently asked questions",
      "blocks": [
        {
          "type": "question"
        }
      ]
    }
  ],
  "class": "n90-clean"
}
{% endschema %}
