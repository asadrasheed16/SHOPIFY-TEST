{%- comment -%}
  sections/hero-slideshow.liquid
  Nineties90 Direction C "Clean Sport Motion"
  Source: data-section="HeroSlideshow" (ref lines 1068-1092)
  CSS source: ref lines 757-790, 895-925
  Architecture: Shopify 2.0 / Dawn baseline-compatible
    - Section colour tokens from schema pickers (--n90-bg/ink/accent/muted/line)
    - Zero-layout-shift via CSS aspect-ratio, not fixed px heights
    - First slide: loading=eager fetchpriority=high; all others: loading=lazy
    - Pure CSS animations + breakpoints, no JS frameworks
    - Vanilla JS IIFE: autoplay, pause-on-hover, keyboard, swipe, Theme Editor
{%- endcomment -%}

{%- liquid
  assign slide_count = section.blocks.size
  assign speed_s     = section.settings.autoplay_speed
  assign speed_ms    = speed_s | times: 1000
  assign bg          = section.settings.color_background
  assign ink         = section.settings.color_text
  assign accent      = section.settings.color_accent
  assign muted       = section.settings.color_muted
  assign line_col    = section.settings.color_line
  assign pt          = section.settings.padding_top
  assign pb          = section.settings.padding_bottom
  assign img_ratio   = section.settings.media_aspect_ratio
  assign title_vw    = section.settings.title_size_vw
  assign title_max   = section.settings.title_size_max
-%}

{%- style -%}
  #shopify-section-{{ section.id }} {
    --nn-canvas: #FFFFFF;
    --nn-ink: #181818;
    --nn-surface: #F4F4F5;
    --nn-volt: #D4FF3A;
    --n90-bg: var(--nn-canvas);
    --n90-ink: var(--nn-ink);
    --n90-accent: var(--nn-volt);
    --n90-muted: var(--nn-ink);
    --n90-line: var(--nn-ink);
    --n90-ease:   cubic-bezier(.2,.7,.2,1);
    --n90-spring: cubic-bezier(.2,1.25,.35,1);
    --n90-radius: 4px;
  }
  @keyframes n90-bar { from { transform: scaleX(0) } to { transform: scaleX(1) } }
  @keyframes n90-shine {
    from { transform: translateX(-140%) skewX(-20deg) }
    to   { transform: translateX(260%)  skewX(-20deg) }
  }
  .n90-hs {
    padding-top: {{ pt }}px;
    padding-bottom: {{ pb }}px;
    background: var(--n90-bg);
    color: var(--n90-ink);
    position: relative;
  }
  .n90-hs__stage { position: relative; }
  .n90-hs__slide {
    position: absolute; inset: 0;
    display: grid;
    grid-template-columns: repeat(12, minmax(0, 1fr));
    column-gap: 24px;
    align-items: center;
    visibility: hidden;
    pointer-events: none;
  }
  .n90-hs__slide[aria-hidden="false"] {
    position: relative; visibility: visible; pointer-events: auto;
  }
  .n90-hs__media {
    grid-column: 1 / span 7;
    position: relative; overflow: hidden;
    border-radius: var(--n90-radius);
    background-color: var(--nn-surface, #F4F4F5);
    aspect-ratio: 1 / 1;
    width: 100%;
    max-width: 580px;
    clip-path: inset(0 100% 0 0);
    transition: clip-path 1.1s var(--n90-ease);
  }
  .n90-hs__slide[aria-hidden="false"] .n90-hs__media { clip-path: inset(0 0 0 0); }
  .n90-hs__slide[aria-hidden="true"]  .n90-hs__media {
    clip-path: inset(0 0 0 100%);
    transition: clip-path 1.1s var(--n90-ease);
  }
  .n90-hs__img {
    position: absolute; inset: 0;
    width: 100%; height: 100%;
    object-fit: cover;
    object-position: {{ section.settings.image_position }};
    display: block;
  }
  .n90-hs__placeholder {
    position: absolute; inset: 0;
    display: flex; align-items: center; justify-content: center;
    background: var(--n90-line);
  }
  .n90-hs__placeholder svg { width: 25%; height: auto; opacity: .2; }
  .n90-hs__overlay {
    position: absolute; inset: 0;
    background: {{ section.settings.overlay_color }};
    opacity: {{ section.settings.overlay_opacity | divided_by: 100.0 }};
    pointer-events: none; z-index: 1;
  }
  .n90-hs__card {
    position: absolute; left: 24px; bottom: 56px; z-index: 3;
    background: var(--n90-bg); border: 1px solid var(--n90-line);
    padding: 14px 18px; display: flex; gap: 14px; align-items: center;
    border-radius: var(--n90-radius);
    opacity: 0; transform: translateY(16px);
    transition: opacity .6s .8s var(--n90-ease), transform .6s .8s var(--n90-ease);
  }
  .n90-hs__slide[aria-hidden="false"] .n90-hs__card { opacity: 1; transform: none; }
  .n90-hs__card-crest {
    width: 44px; height: 44px; border-radius: 50%;
    border: 1px solid var(--n90-line); overflow: hidden; flex: none;
    background: var(--n90-line);
    display: flex; align-items: center; justify-content: center;
    font-size: 10px; letter-spacing: .04em; color: var(--n90-muted);
  }
  .n90-hs__card-crest img { width: 100%; height: 100%; object-fit: contain; display: block; }
  .n90-hs__card-name { font-size: 14px; font-weight: 600; color: var(--n90-ink); line-height: 1.2; }
  .n90-hs__card-sub  { font-size: 12px; color: var(--n90-muted); margin-top: 2px; }
  .n90-hs__text {
    grid-column: 8 / span 5;
    padding: 0 0 {{ pb | divided_by: 2 }}px 24px;
    display: flex; flex-direction: column; gap: 24px; min-width: 0;
  }
  .n90-hs__text > * {
    opacity: 0; transform: translateY(24px);
    transition: opacity .6s var(--n90-ease), transform .7s var(--n90-ease);
  }
  .n90-hs__slide[aria-hidden="false"] .n90-hs__text > *    { opacity: 1; transform: none; }
  .n90-hs__slide[aria-hidden="false"] .n90-hs__eyebrow     { transition-delay: .25s; }
  .n90-hs__slide[aria-hidden="false"] .n90-hs__heading     { transition-delay: .35s; }
  .n90-hs__slide[aria-hidden="false"] .n90-hs__sub         { transition-delay: .50s; }
  .n90-hs__slide[aria-hidden="false"] .n90-hs__cta         { transition-delay: .60s; }
  .n90-hs__eyebrow {
    font-family: 'Barlow Condensed', 'Arial Narrow', sans-serif;
    font-size: 14px; font-weight: 600;
    text-transform: uppercase; letter-spacing: 0.1em; color: var(--nn-ink, #181818);
  }
  .n90-hs__heading {
    font-family: 'Barlow Condensed', 'Arial Narrow', sans-serif;
    font-size: clamp(46px, {{ title_vw }}vw, {{ title_max }}px);
    font-weight: 700; text-transform: uppercase; letter-spacing: .005em;
    line-height: .95; margin: 0; color: var(--nn-ink, #181818);
  }
  .n90-hs__heading > p { margin: 0; }
  .n90-hs__sub { font-size: clamp(16px, 1.25vw, 19px); line-height: 1.55; color: var(--nn-ink, #181818); }
  .n90-hs__cta { display: flex; align-items: center; gap: 28px; flex-wrap: wrap; }
  .n90-hs__btn {
    display: inline-flex; align-items: center; justify-content: center; gap: 10px;
    min-height: 52px; padding: 0 28px;
    background-color: var(--nn-volt, #D4FF3A); color: #181818;
    font-family: 'Barlow Condensed', 'Arial Narrow', sans-serif;
    font-size: 17px; font-weight: 700; text-transform: uppercase; letter-spacing: .07em;
    border-radius: var(--n90-radius); border: 0; text-decoration: none; cursor: pointer;
    position: relative; overflow: hidden; white-space: nowrap;
    transition: opacity .2s, transform .35s var(--n90-ease);
  }
  .n90-hs__btn::after {
    content: ''; position: absolute; top: 0; bottom: 0; left: 0; width: 40%;
    background: rgba(255,255,255,.5);
    transform: translateX(-140%) skewX(-20deg); pointer-events: none;
  }
  .n90-hs__btn:hover::after { animation: n90-shine .9s var(--n90-ease); }
  .n90-hs__btn:active { transform: scale(.97); }
  .n90-hs__btn svg { transition: transform .35s var(--n90-ease); flex: none; }
  .n90-hs__btn:hover svg { transform: translateX(4px); }
  .n90-hs__tlink {
    display: inline-flex; align-items: center; gap: 8px; min-height: 44px;
    font-family: 'Barlow Condensed', 'Arial Narrow', sans-serif;
    font-size: 16px; font-weight: 600; text-transform: uppercase; letter-spacing: .07em;
    color: var(--nn-ink, #181818);
    text-decoration: underline; text-underline-offset: 7px;
    text-decoration-thickness: 1px; text-decoration-color: var(--nn-ink, #181818);
    transition: text-underline-offset .25s var(--n90-ease), text-decoration-thickness .15s;
    background: none; border: 0; cursor: pointer; padding: 0; white-space: nowrap;
  }
  .n90-hs__tlink:hover { text-underline-offset: 3px; text-decoration-thickness: 2px; }
  .n90-hs__ctrl {
    position: absolute; bottom: 0; right: 0;
    width: calc((100% - 11 * 24px) / 12 * 5 + 4 * 24px);
    padding-left: 24px; display: flex; align-items: center; gap: 16px; z-index: 3;
  }
  .n90-hs__count {
    font-family: 'Barlow Condensed', 'Arial Narrow', sans-serif;
    font-size: 18px; letter-spacing: .08em; font-variant-numeric: tabular-nums;
    white-space: nowrap; text-transform: uppercase; font-weight: 600; color: var(--n90-ink);
  }
  .n90-hs__bars { display: flex; gap: 6px; flex: 1; max-width: 220px; }
  .n90-hs__bar {
    flex: 1; height: 44px; display: flex; align-items: center;
    position: relative; background: transparent; border: 0; padding: 0; cursor: pointer;
  }
  .n90-hs__bar::before {
    content: ''; position: absolute;
    left: 0; right: 0; top: 50%; height: 3px; margin-top: -1.5px;
    background: var(--n90-line); border-radius: 2px;
  }
  .n90-hs__bar > span {
    position: absolute; left: 0; top: 50%; height: 3px; margin-top: -1.5px;
    width: 100%; background: var(--n90-ink); border-radius: 2px;
    transform: scaleX(0); transform-origin: left;
  }
  .n90-hs__bar--done > span { transform: scaleX(1); }
  .n90-hs__bar--on > span {
    animation: n90-bar {{ speed_s }}s linear forwards;
  }
  .n90-hs[data-paused] .n90-hs__bar--on > span { animation-play-state: paused; }
  .n90-hs__arrow {
    width: 48px; height: 48px; border-radius: 50%;
    border: 1px solid var(--nn-ink, #181818);
    display: inline-flex; align-items: center; justify-content: center;
    flex: none; background: transparent; color: var(--nn-ink, #181818); cursor: pointer;
    transition: background .25s, color .25s, transform .3s var(--n90-spring);
  }
  .n90-hs__arrow:hover  { background: var(--nn-ink, #181818); color: var(--nn-canvas, #FFFFFF); }
  .n90-hs__arrow:active { transform: scale(.92); }
  @media (prefers-reduced-motion: reduce) {
    #shopify-section-{{ section.id }} *,
    #shopify-section-{{ section.id }} *::before,
    #shopify-section-{{ section.id }} *::after {
      animation-duration: .001ms !important; animation-iteration-count: 1 !important;
      transition-duration: .001ms !important;
    }
    .n90-hs__slide[aria-hidden="false"] .n90-hs__media,
    .n90-hs__slide[aria-hidden="false"] .n90-hs__text > * {
      opacity: 1 !important; transform: none !important; clip-path: none !important;
    }
  }
  @media screen and (max-width: 749px) {
    .n90-hs { padding-top: {{ pt | at_most: 40 }}px; padding-bottom: {{ pb | at_most: 48 }}px; }
    .n90-hs__slide { display: flex; flex-direction: column; align-items: stretch; gap: 0; }
    .n90-hs__text  { order: 1; grid-column: auto; padding: 24px 0 72px; gap: 16px; }
    .n90-hs__media {
      order: 2; grid-column: auto; aspect-ratio: 4 / 3; border-radius: 0;
      clip-path: none !important; transition: none;
    }
    .n90-hs__heading { font-size: clamp(36px, 11vw, 46px) !important; }
    .n90-hs__cta { flex-direction: column; align-items: stretch; gap: 4px; }
    .n90-hs__btn   { width: 100%; justify-content: center; }
    .n90-hs__tlink { justify-content: center; }
    .n90-hs__ctrl  { width: 100%; padding-left: 0; }
    .n90-hs__card  { left: 12px; bottom: 44px; }
  }
  @media screen and (min-width: 750px) and (max-width: 1023px) {
    .n90-hs__heading { font-size: clamp(38px, 5vw, 64px) !important; }
    .n90-hs__text { padding-left: 16px; }
  }
{%- endstyle -%}

<section
  class="n90-hs"
  id="n90-hs-{{ section.id }}"
  data-section-id="{{ section.id }}"
  data-autoplay="{{ section.settings.autoplay }}"
  data-speed="{{ speed_ms }}"
  aria-roledescription="carousel"
  aria-label="{{ section.settings.aria_label | default: 'Featured' | escape }}"
>
  <div class="page-width">
    <div class="n90-hs__stage" id="n90-hs-stage-{{ section.id }}">

      {%- for block in section.blocks -%}
        {%- liquid
          assign idx      = forloop.index
          assign is_first = forloop.first
          if forloop.first
            assign aria_h   = 'false'
            assign loading  = 'eager'
            assign fetchpri = 'high'
          else
            assign aria_h   = 'true'
            assign loading  = 'lazy'
            assign fetchpri = 'auto'
          endif
        -%}

        <div
          class="n90-hs__slide"
          id="n90-hs-slide-{{ section.id }}-{{ idx }}"
          role="group"
          aria-roledescription="slide"
          aria-label="{{ idx }} of {{ slide_count }}"
          aria-hidden="{{ aria_h }}"
          {{ block.shopify_attributes }}
        >

          <!-- Media column (7/12) ref: .sl-media -->
          <div class="n90-hs__media">
            {%- if block.settings.image != blank -%}
              {%- assign img = block.settings.image -%}
              <img
                class="n90-hs__img"
                src="{{ img | image_url: width: 1400 }}"
                srcset="{{ img | image_url: width: 375 }} 375w,
                        {{ img | image_url: width: 600 }} 600w,
                        {{ img | image_url: width: 800 }} 800w,
                        {{ img | image_url: width: 1000 }} 1000w,
                        {{ img | image_url: width: 1200 }} 1200w,
                        {{ img | image_url: width: 1400 }} 1400w"
                sizes="(max-width: 749px) 100vw, 58vw"
                width="{{ img.width }}"
                height="{{ img.height }}"
                alt="{{ img.alt | default: block.settings.heading | strip_html | escape }}"
                loading="{{ loading }}"
                fetchpriority="{{ fetchpri }}"
              >
            {%- else -%}
              <div class="n90-hs__placeholder">
                {{ 'collection-1' | placeholder_svg_tag }}
              </div>
            {%- endif -%}

            {%- if section.settings.overlay_opacity > 0 -%}
              <div class="n90-hs__overlay" aria-hidden="true"></div>
            {%- endif -%}

            {%- if block.settings.show_club_card and block.settings.club_name != blank -%}
              <div class="n90-hs__card" aria-hidden="true">
                <div class="n90-hs__card-crest">
                  {%- if block.settings.club_crest != blank -%}
                    <img
                      src="{{ block.settings.club_crest | image_url: width: 88 }}"
                      width="44" height="44"
                      alt="{{ block.settings.club_name | escape }}"
                      loading="lazy"
                    >
                  {%- else -%}Crest{%- endif -%}
                </div>
                <div>
                  <p class="n90-hs__card-name">{{ block.settings.club_name | escape }}</p>
                  {%- if block.settings.club_subtitle != blank -%}
                    <p class="n90-hs__card-sub">{{ block.settings.club_subtitle | escape }}</p>
                  {%- endif -%}
                </div>
              </div>
            {%- endif -%}
          </div><!-- /n90-hs__media -->

          <!-- Text column (5/12) ref: .sl-text -->
          <div class="n90-hs__text">
            {%- if block.settings.eyebrow != blank -%}
              <p class="n90-hs__eyebrow">{{ block.settings.eyebrow | escape }}</p>
            {%- endif -%}

            {%- if block.settings.heading != blank -%}
              {%- if is_first -%}
                <h1 class="n90-hs__heading">{{ block.settings.heading }}</h1>
              {%- else -%}
                <h2 class="n90-hs__heading">{{ block.settings.heading }}</h2>
              {%- endif -%}
            {%- endif -%}

            {%- if block.settings.subheading != blank -%}
              <p class="n90-hs__sub">{{ block.settings.subheading | escape }}</p>
            {%- endif -%}

            {%- if block.settings.cta_primary_label != blank or block.settings.cta_secondary_label != blank -%}
              <div class="n90-hs__cta">
                {%- if block.settings.cta_primary_label != blank -%}
                  <a
                    href="{{ block.settings.cta_primary_url | default: '#' }}"
                    class="n90-hs__btn"
                    {%- unless is_first %} tabindex="-1"{%- endunless %}
                  >
                    {{- block.settings.cta_primary_label | escape -}}
                    <svg width="16" height="16" viewBox="0 0 24 24"
                      fill="none" stroke="currentColor" stroke-width="2"
                      aria-hidden="true" focusable="false">
                      <path d="M5 12h14M13 6l6 6-6 6"/>
                    </svg>
                  </a>
                {%- endif -%}
                {%- if block.settings.cta_secondary_label != blank -%}
                  <a
                    href="{{ block.settings.cta_secondary_url | default: '#' }}"
                    class="n90-hs__tlink"
                    {%- unless is_first %} tabindex="-1"{%- endunless %}
                  >
                    {{- block.settings.cta_secondary_label | escape -}}
                  </a>
                {%- endif -%}
              </div>
            {%- endif -%}
          </div><!-- /n90-hs__text -->

        </div><!-- /n90-hs__slide -->
      {%- endfor -%}

      {%- if slide_count > 1 -%}
        <!-- Controls ref: .sl-ctrl -->
        <div class="n90-hs__ctrl" id="n90-hs-ctrl-{{ section.id }}">
          <span class="n90-hs__count" id="n90-hs-count-{{ section.id }}"
            aria-live="polite" aria-atomic="true">
            <strong>01</strong>&thinsp;/&thinsp;{{ slide_count | prepend: '0' | slice: -2, 2 }}
          </span>
          <div class="n90-hs__bars" role="tablist" aria-label="Slide navigation">
            {%- for block in section.blocks -%}
              <button
                class="n90-hs__bar{% if forloop.first %} n90-hs__bar--on{% endif %}"
                role="tab"
                aria-label="{{ 'sections.slideshow.load_slide' | t | default: 'Go to slide' }} {{ forloop.index }}"
                aria-controls="n90-hs-slide-{{ section.id }}-{{ forloop.index }}"
                aria-selected="{{ forloop.first | json }}"
                data-bar-index="{{ forloop.index0 }}"
              ><span></span></button>
            {%- endfor -%}
          </div>
          <span style="flex:1" aria-hidden="true"></span>
          <button class="n90-hs__arrow" id="n90-hs-prev-{{ section.id }}"
            aria-label="{{ 'sections.slideshow.previous_slideshow' | t | default: 'Previous slide' }}">
            <svg width="20" height="20" viewBox="0 0 24 24" fill="none"
              stroke="currentColor" stroke-width="1.5" aria-hidden="true" focusable="false">
              <path d="M15 6l-6 6 6 6"/>
            </svg>
          </button>
          <button class="n90-hs__arrow" id="n90-hs-next-{{ section.id }}"
            aria-label="{{ 'sections.slideshow.next_slide' | t | default: 'Next slide' }}">
            <svg width="20" height="20" viewBox="0 0 24 24" fill="none"
              stroke="currentColor" stroke-width="1.5" aria-hidden="true" focusable="false">
              <path d="M9 6l6 6-6 6"/>
            </svg>
          </button>
        </div><!-- /n90-hs__ctrl -->
      {%- endif -%}

    </div><!-- /n90-hs__stage -->
  </div><!-- /page-width -->
</section>

<script>
(function () {
  'use strict';
  var ID   = {{ section.id | json }};
  var N    = {{ slide_count }};
  var root = document.getElementById('n90-hs-' + ID);
  if (!root || N < 2) return;

  var AUTOPLAY = root.dataset.autoplay === 'true';
  var SPEED    = parseInt(root.dataset.speed, 10) || 6500;
  var slides   = Array.from(root.querySelectorAll('.n90-hs__slide'));
  var bars     = Array.from(root.querySelectorAll('.n90-hs__bar'));
  var countEl  = document.getElementById('n90-hs-count-' + ID);
  var prevBtn  = document.getElementById('n90-hs-prev-' + ID);
  var nextBtn  = document.getElementById('n90-hs-next-' + ID);
  var current  = 0;
  var timer    = null;

  function pad(n)  { return n < 9  ? '0' + (n + 1) : '' + (n + 1); }
  function padN(n) { return n < 10 ? '0' + n : '' + n; }

  function goTo(next) {
    next = ((next % N) + N) % N;
    if (next === current) return;
    var prev = current;
    current  = next;
    slides[prev].setAttribute('aria-hidden', 'true');
    slides[current].setAttribute('aria-hidden', 'false');
    slides[prev].querySelectorAll('a[href], button').forEach(function(el) {
      el.setAttribute('tabindex', '-1');
    });
    slides[current].querySelectorAll('a[href], button').forEach(function(el) {
      el.removeAttribute('tabindex');
    });
    bars.forEach(function(bar, i) {
      bar.classList.remove('n90-hs__bar--on', 'n90-hs__bar--done');
      bar.setAttribute('aria-selected', 'false');
      if (i < current) bar.classList.add('n90-hs__bar--done');
    });
    bars[current].classList.add('n90-hs__bar--on');
    bars[current].setAttribute('aria-selected', 'true');
    var span = bars[current].querySelector('span');
    if (span) span.parentNode.replaceChild(span.cloneNode(false), span);
    if (countEl) {
      countEl.innerHTML = '<strong>' + pad(current) + '</strong>&thinsp;/&thinsp;' + padN(N);
    }
  }

  function next() { goTo(current + 1); }
  function prev() { goTo(current - 1); }
  function startTimer() { if (!AUTOPLAY) return; stopTimer(); timer = setInterval(next, SPEED); }
  function stopTimer()  { if (timer) { clearInterval(timer); timer = null; } }

  if (prevBtn) prevBtn.addEventListener('click', function() { stopTimer(); prev(); startTimer(); });
  if (nextBtn) nextBtn.addEventListener('click', function() { stopTimer(); next(); startTimer(); });
  bars.forEach(function(bar, i) {
    bar.addEventListener('click', function() { stopTimer(); goTo(i); startTimer(); });
  });
  root.addEventListener('mouseenter', function() { root.dataset.paused = ''; stopTimer(); });
  root.addEventListener('mouseleave', function() { delete root.dataset.paused; startTimer(); });
  root.addEventListener('keydown', function(e) {
    if (e.key === 'ArrowRight' || e.key === 'ArrowDown') { stopTimer(); next(); startTimer(); }
    else if (e.key === 'ArrowLeft' || e.key === 'ArrowUp') { stopTimer(); prev(); startTimer(); }
  });
  var touchX = 0;
  root.addEventListener('touchstart', function(e) { touchX = e.changedTouches[0].screenX; }, { passive: true });
  root.addEventListener('touchend', function(e) {
    var dx = e.changedTouches[0].screenX - touchX;
    if (Math.abs(dx) < 40) return;
    stopTimer(); (dx < 0 ? next : prev)(); startTimer();
  }, { passive: true });
  document.addEventListener('shopify:block:select', function(e) {
    var idx = slides.indexOf(e.target);
    if (idx !== -1) { stopTimer(); goTo(idx); }
  });
  document.addEventListener('shopify:block:deselect', startTimer);
  slides.forEach(function(sl, i) {
    if (i === 0) return;
    sl.querySelectorAll('a[href], button').forEach(function(el) { el.setAttribute('tabindex', '-1'); });
  });
  startTimer();
})();
</script>

