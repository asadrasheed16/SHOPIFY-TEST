{% assign quote_url = pages['kit-builder'].url %}{% if quote_url == blank %}{% assign quote_url = routes.root_url | append: '#TeamQuote' %}{% endif %}
<section class="quote-banner dark-band"><div class="wrap"><div><span class="eyebrow">{{ section.settings.eyebrow | escape }}</span><h2 class="d h2">{{ section.settings.heading | escape }}</h2></div><a class="btn" href="{{ quote_url }}">{{ section.settings.button_label | escape }} {% render 'n90-clean-icon', name: 'arrow' %}</a></div></section>

{% schema %}
{
  "name": "Quote banner",
  "settings": [
    {
      "type": "text",
      "id": "eyebrow",
      "label": "Eyebrow",
      "default": "Let’s build your next kit"
    },
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "Your colours. Your club."
    },
    {
      "type": "text",
      "id": "button_label",
      "label": "Button label",
      "default": "Get a free team quote"
    }
  ],
  "presets": [
    {
      "name": "Quote banner"
    }
  ],
  "class": "n90-clean"
}
{% endschema %}
