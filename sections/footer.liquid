{%- comment -%}
  sections/footer.liquid
  Nineties90 — Dark Footer Clone & Refactor
{%- endcomment -%}

<style>
  /* ══════════════════════════════════════════════════════════
     Direction C · Clean Sport — Global Design Tokens 
     (Overridden for Dark Theme Footer)
     ══════════════════════════════════════════════════════════ */
  #shopify-section-{{ section.id }} {
    --bg: #0b0d0e;
    --surface: rgba(255, 255, 255, 0.05);
    --ink: #ffffff;
    --muted: #9ca3af;
    --line: rgba(255, 255, 255, 0.1);
    --line-strong: rgba(255, 255, 255, 0.2);
    --accent: #ccff00;
    --btn-bg: #ccff00;
    --btn-ink: #000000;
    --radius: 4px;
    --pill: 4px;
    --dfam: 'Barlow Condensed', system-ui, sans-serif;
    --bfam: 'Barlow', system-ui, sans-serif;
    --dweight: 700;
    --dcase: uppercase;
    --dtrack: 0.05em;
    --dlh: 0.95;
    
    background-color: var(--bg);
    color: var(--ink);
  }

  /* ---------- Base Wrappers & Typography ---------- */
  .ftr {
    border-top: 1px solid var(--line);
    padding: 80px 0 32px;
    font-family: var(--bfam);
  }
  .wrap {
    max-width: 1280px;
    margin: 0 auto;
    padding: 0 24px;
  }
  .eyebrow {
    font-family: var(--dfam);
    font-weight: var(--dweight);
    text-transform: var(--dcase);
    letter-spacing: var(--dtrack);
    color: var(--ink);
    font-size: 16px;
    margin-bottom: 16px;
  }
  .muted { color: var(--muted); }
  .mt8 { margin-top: 8px; }
  .mt24 { margin-top: 24px; }
  
  .logo {
    font-family: var(--dfam);
    font-weight: 700;
    font-style: italic;
    font-size: 24px;
    letter-spacing: 0.1em;
    color: var(--ink);
    text-decoration: none;
  }

  /* ---------- Explicit 5-Column Grid ---------- */
  .cols {
    display: grid;
    grid-template-columns: 2fr 1fr 1fr 1fr 1.5fr;
    gap: 40px;
  }
  @media screen and (max-width: 1024px) {
    .cols { grid-template-columns: 1fr 1fr 1fr; gap: 32px; }
  }
  @media screen and (max-width: 768px) {
    .cols { grid-template-columns: 1fr; gap: 32px; }
    .ftr { padding: 48px 0 96px; }
  }

  /* ---------- Links ---------- */
  .flink {
    display: flex;
    align-items: center;
    min-height: 36px;
    font-size: 14px;
    color: var(--muted);
    width: 100%;
    text-decoration: none;
    line-height: 2;
    transition: color 0.2s ease;
    background: transparent;
    border: none;
    padding: 0;
    text-align: left;
    cursor: pointer;
  }
  .flink:hover { color: var(--ink); }

  /* ---------- Sub-Footer ---------- */
  .ftr-bottom {
    border-top: 1px solid var(--line);
    margin-top: 64px;
    padding-top: 24px;
    display: flex;
    justify-content: space-between;
    align-items: center;
    gap: 16px;
    font-size: 13px;
    color: var(--muted);
    flex-wrap: wrap;
  }
  @media screen and (max-width: 768px) {
    .ftr-bottom { margin-top: 40px; flex-direction: column; text-align: center; }
  }
  .ftr-bottom a {
    color: var(--muted);
    text-decoration: none;
  }
  .ftr-bottom a:hover { color: var(--ink); }

  /* ---------- Forms ---------- */
  .field { display: flex; flex-direction: column; gap: 8px; }
  .label { font-size: 14px; font-weight: 500; }
  .sub-row { display: flex; gap: 8px; margin-top: 8px; }
  
  .input {
    min-height: 44px;
    padding: 0 16px;
    border: 1px solid var(--line-strong);
    background: var(--surface);
    color: var(--ink);
    border-radius: var(--radius);
    width: 100%;
    font-size: 14px;
    font-family: var(--bfam);
  }
  .input::placeholder { color: var(--muted); }
  
  .btn-line {
    background: var(--btn-bg);
    color: var(--btn-ink);
    font-weight: 700;
    font-family: var(--bfam);
    border: none;
    border-radius: var(--radius);
    padding: 0 18px;
    font-size: 14px;
    cursor: pointer;
    min-height: 44px;
    white-space: nowrap;
    transition: opacity 0.2s ease;
  }
  .btn-line:hover { opacity: 0.9; }

  /* Form Message overrides */
  .form-message { font-size: 13px; margin-top: 8px; }
  .form-message--success { color: var(--accent); }
  .form-message--error { color: #FF4D4D; }
</style>

<footer class="ftr" data-section="Footer">
  <div class="wrap">
    <div class="cols">
      
      {%- comment -%} Col 1: Brand {%- endcomment -%}
      <div class="s-brand">
        {%- if section.settings.logo != blank -%}
          <img src="{{ section.settings.logo | image_url: width: 300 }}" alt="{{ shop.name | escape }}" style="max-width: {{ section.settings.logo_width }}px; height: auto;">
        {%- else -%}
          <a href="/" class="logo">{{ shop.name }}</a>
        {%- endif -%}
        <p class="small muted mt8">{{ section.settings.brand_bio | escape | default: 'Custom teamwear for grassroots clubs. Built for the full 90 minutes.' }}</p>
      </div>

      {%- comment -%} Col 2: Nav 1 {%- endcomment -%}
      <div>
        <p class="eyebrow">Sports</p>
        {%- assign menu1 = section.blocks[0].settings.menu -%}
        {%- if menu1 != blank and linklists[menu1].links.size > 0 -%}
          {%- for link in linklists[menu1].links -%}
            <a href="{{ link.url }}" class="flink">{{ link.title }}</a>
          {%- endfor -%}
        {%- else -%}
          <a href="#" class="flink">Footballs</a>
          <a href="#" class="flink">Goalkeeper Gloves</a>
          <a href="#" class="flink">Kits</a>
          <a href="#" class="flink">Training Gear</a>
        {%- endif -%}
      </div>

      {%- comment -%} Col 3: Nav 2 {%- endcomment -%}
      <div>
        <p class="eyebrow">Shop</p>
        {%- assign menu2 = section.blocks[1].settings.menu -%}
        {%- if menu2 != blank and linklists[menu2].links.size > 0 -%}
          {%- for link in linklists[menu2].links -%}
            <a href="{{ link.url }}" class="flink">{{ link.title }}</a>
          {%- endfor -%}
        {%- else -%}
          <a href="#" class="flink">New Drops</a>
          <a href="#" class="flink">Best Sellers</a>
          <a href="#" class="flink">Club Bundles</a>
        {%- endif -%}
      </div>

      {%- comment -%} Col 4: Nav 3 {%- endcomment -%}
      <div>
        <p class="eyebrow">Help</p>
        {%- assign menu3 = section.blocks[2].settings.menu -%}
        {%- if menu3 != blank and linklists[menu3].links.size > 0 -%}
          {%- for link in linklists[menu3].links -%}
            <a href="{{ link.url }}" class="flink">{{ link.title }}</a>
          {%- endfor -%}
        {%- else -%}
          <a href="#" class="flink">Size Guide</a>
          <a href="#" class="flink">Shipping & Returns</a>
          <a href="#" class="flink">Latex Care</a>
          <a href="#" class="flink">Contact</a>
        {%- endif -%}
      </div>

      {%- comment -%} Col 5: Newsletter {%- endcomment -%}
      <div>
        <p class="eyebrow">{{ section.settings.newsletter_heading | default: 'Match Alerts' }}</p>
        <p class="small muted mt8">{{ section.settings.newsletter_text | default: 'Get 10% off your first order.' }}</p>
        <div class="field mt24">
          {% form 'customer' %}
            <input type="hidden" name="contact[tags]" value="newsletter">
            <div class="sub-row">
              <input id="nn-nl" name="contact[email]" class="input" type="email" placeholder="Email address" required aria-label="Email address">
              <button type="submit" class="btn-line btn-sm">Sign up</button>
            </div>
            {%- if form.posted_successfully? -%}
              <div class="form-message form-message--success">Thanks for subscribing!</div>
            {%- elsif form.errors -%}
              <div class="form-message form-message--error">{{ form.errors | default_errors }}</div>
            {%- endif -%}
          {% endform %}
        </div>
      </div>

    </div>

    <div class="ftr-bottom">
      <span>&copy; {{ 'now' | date: '%Y' }} {{ shop.name }}</span>
      <span>
        {%- for type in shop.enabled_payment_types -%}
          {{ type | payment_type_svg_tag: class: 'icon icon--full-color' }}
        {%- endfor -%}
      </span>
      <span>
        {%- if shop.policies != blank -%}
          {%- for policy in shop.policies -%}
            <a href="{{ policy.url }}">{{ policy.title }}</a>{% unless forloop.last %} &middot; {% endunless %}
          {%- endfor -%}
        {%- else -%}
          <a href="#">Privacy Policy</a> &middot; 
          <a href="#">Terms of Service</a> &middot; 
          <a href="#">Refund Policy</a>
        {%- endif -%}
      </span>
    </div>
  </div>
</footer>

{% schema %}
{
  "name": "Footer",
  "settings": [
    {
      "type": "header",
      "content": "Brand"
    },
    {
      "type": "image_picker",
      "id": "logo",
      "label": "Logo image"
    },
    {
      "type": "range",
      "id": "logo_width",
      "label": "Logo width",
      "min": 50,
      "max": 300,
      "step": 10,
      "unit": "px",
      "default": 140
    },
    {
      "type": "text",
      "id": "brand_bio",
      "label": "Brand statement",
      "default": "Custom teamwear for grassroots clubs. Built for the full 90 minutes."
    },
    {
      "type": "header",
      "content": "Newsletter"
    },
    {
      "type": "text",
      "id": "newsletter_heading",
      "label": "Newsletter heading",
      "default": "Match Alerts"
    },
    {
      "type": "text",
      "id": "newsletter_text",
      "label": "Newsletter text",
      "default": "Get 10% off your first order."
    }
  ],
  "blocks": [
    {
      "type": "link_list",
      "name": "Menu column",
      "settings": [
        {
          "type": "text",
          "id": "heading",
          "label": "Column heading",
          "default": "Quick links"
        },
        {
          "type": "link_list",
          "id": "menu",
          "label": "Menu"
        }
      ]
    }
  ]
}
{% endschema %}
