{%- comment -%}
  sections/footer.liquid
  Nineties90 — Direction C "Clean Sport · Motion"
  Exact HTML Match from Reference
{%- endcomment -%}

<footer class="ftr" data-section="Footer" id="shopify-section-{{ section.id }}">
  <div class="wrap">
    <div class="cols">
      
      {%- comment -%}── Column 1: Brand & Newsletter ──{%- endcomment -%}
      <div class="s4">
        {%- if section.settings.logo != blank -%}
          <img src="{{ section.settings.logo | image_url: width: 300 }}" alt="{{ shop.name | escape }}" class="logo-img" style="max-width: {{ section.settings.logo_width }}px; height: auto;">
        {%- else -%}
          <span class="logo">{{ shop.name }}</span>
        {%- endif -%}
        
        <p class="small muted mt8">{{ section.settings.brand_bio | escape }}</p>

        {%- if section.settings.show_social -%}
          <div class="mt16" style="display: flex; gap: 12px; color: var(--nn-ink);">
            {%- if settings.social_instagram_link != blank -%}<a href="{{ settings.social_instagram_link }}" aria-label="Instagram">{% render 'icon-instagram' %}</a>{%- endif -%}
            {%- if settings.social_tiktok_link != blank -%}<a href="{{ settings.social_tiktok_link }}" aria-label="TikTok">{% render 'icon-tiktok' %}</a>{%- endif -%}
            {%- if settings.social_youtube_link != blank -%}<a href="{{ settings.social_youtube_link }}" aria-label="YouTube">{% render 'icon-youtube' %}</a>{%- endif -%}
            {%- if settings.social_twitter_link != blank -%}<a href="{{ settings.social_twitter_link }}" aria-label="X (Twitter)">{% render 'icon-twitter' %}</a>{%- endif -%}
          </div>
        {%- endif -%}

        {% form 'customer', class: 'mt24' %}
          <div class="field">
            <label class="label" for="nn-nl-{{ section.id }}">{{ section.settings.newsletter_title | escape }}</label>
            <input type="hidden" name="contact[tags]" value="newsletter">
            <div class="sub-row">
              <input id="nn-nl-{{ section.id }}" class="input" type="email" name="contact[email]" placeholder="Email address" style="min-height: 44px" required>
              <button type="submit" class="btn-line btn-sm">Sign up</button>
            </div>
            {%- if form.posted_successfully? -%}
              <p class="small mt8" style="color: var(--nn-accent);">Thanks for subscribing!</p>
            {%- elsif form.errors -%}
              <p class="small mt8" style="color: #FF4D4D;">{{ form.errors | default_errors }}</p>
            {%- endif -%}
          </div>
        {% endform %}
      </div>

      {%- comment -%}── Column 2: Navigation Lists ──{%- endcomment -%}
      <div class="s8 ftr-cols">
        {%- for block in section.blocks -%}
          {%- if block.type == 'link_list' -%}
            <div {{ block.shopify_attributes }}>
              <p class="eyebrow">{{ block.settings.heading | escape }}</p>
              {%- if block.settings.menu != blank -%}
                {%- for link in linklists[block.settings.menu].links -%}
                  <a href="{{ link.url }}" class="flink" style="display:block; text-decoration:none;">{{ link.title }}</a>
                {%- endfor -%}
              {%- endif -%}
            </div>
          {%- endif -%}
        {%- endfor -%}
      </div>
      
    </div>

    {%- comment -%}── Bottom Utility Bar ──{%- endcomment -%}
    <div class="ftr-bottom">
      <span>&copy; {{ 'now' | date: '%Y' }} {{ shop.name }}. All rights reserved.</span>
      
      {%- if section.settings.show_payment_icons -%}
        <span style="display: flex; gap: 8px;">
          {%- for type in shop.enabled_payment_types -%}
            {{ type | payment_type_svg_tag: class: 'icon icon--full-color', style: 'width: 32px; height: auto;' }}
          {%- endfor -%}
        </span>
      {%- endif -%}
      
      <span style="display: flex; gap: 16px; align-items: center;">
        {%- if section.settings.enable_country_selector and localization.available_countries.size > 1 -%}
          {% form 'localization', id: 'FooterCountryForm', style: 'display:inline-block;' %}
            <select name="country_code" onchange="this.form.submit()" style="background:transparent; color:inherit; border:none; outline:none; font-family:inherit; font-size:inherit; cursor:pointer;">
              {%- for country in localization.available_countries -%}
                <option value="{{ country.iso_code }}" {%- if country.iso_code == localization.country.iso_code %} selected{% endif %} style="color:#000;">
                  {{ country.name }} ({{ country.currency.iso_code }} {{ country.currency.symbol }})
                </option>
              {%- endfor -%}
            </select>
          {% endform %}
        {%- endif -%}

        {%- if shop.policies != blank -%}
          {%- for policy in shop.policies -%}
            <a href="{{ policy.url }}" style="color: inherit; text-decoration: none;">{{ policy.title }}</a>
            {%- unless forloop.last -%} &middot; {%- endunless -%}
          {%- endfor -%}
        {%- endif -%}
      </span>
    </div>

  </div>
</footer>

{% schema %}
{
  "name": "Footer",
  "tag": "section",
  "settings": [
    {
      "type": "header",
      "content": "Brand Info"
    },
    { "type": "image_picker", "id": "logo", "label": "Logo image" },
    { "type": "range", "id": "logo_width", "label": "Logo width", "min": 50, "max": 300, "step": 10, "unit": "px", "default": 140 },
    { "type": "text", "id": "brand_bio", "label": "Brand Ethos", "default": "Custom teamwear for grassroots clubs. Built for the full 90 minutes." },
    { "type": "checkbox", "id": "show_social", "label": "Show social icons", "default": true },
    {
      "type": "header",
      "content": "Newsletter"
    },
    { "type": "text", "id": "newsletter_title", "label": "Newsletter Title", "default": "Get 10% off your first order" },
    {
      "type": "header",
      "content": "Utility Bar"
    },
    { "type": "checkbox", "id": "enable_country_selector", "label": "Enable country/region selector", "default": true },
    { "type": "checkbox", "id": "show_payment_icons", "label": "Show payment icons", "default": true }
  ],
  "blocks": [
    {
      "type": "link_list",
      "name": "Menu Column",
      "settings": [
        { "type": "text", "id": "heading", "label": "Heading", "default": "Quick links" },
        { "type": "link_list", "id": "menu", "label": "Menu" }
      ]
    }
  ],
  "presets": [
    {
      "name": "Footer",
      "blocks": [
        { "type": "link_list", "settings": { "heading": "Sports" } },
        { "type": "link_list", "settings": { "heading": "Shop" } },
        { "type": "link_list", "settings": { "heading": "Help" } }
      ]
    }
  ]
}
{% endschema %}
