{%- comment -%}
  sections/footer.liquid
  Nineties90 — Direction C "Clean Sport · Motion"
  Global Footer & Technical Utility Hub
{%- endcomment -%}

{%- liquid
  assign bg     = section.settings.color_background | default: '#0E1B33'
  assign ink    = section.settings.color_text | default: '#FFFFFF'
  assign muted  = section.settings.color_muted | default: '#8E9DB4'
  assign line   = section.settings.color_line | default: 'rgba(255,255,255,0.15)'
  assign accent = section.settings.color_accent | default: '#D4FF3A'
  assign pt     = section.settings.padding_top | default: 80
  assign pb     = section.settings.padding_bottom | default: 48
-%}

{%- style -%}
  #shopify-section-{{ section.id }} {
    --nn-bg:      {{ bg }};
    --nn-ink:     {{ ink }};
    --nn-muted:   {{ muted }};
    --nn-accent:  {{ accent }};
    --nn-line:    {{ line }};
  }

  .n90-footer {
    background: var(--nn-bg);
    color: var(--nn-ink);
    border-top: 1px solid var(--nn-line);
    padding-top: {{ pt }}px;
    padding-bottom: {{ pb }}px;
  }
  @media screen and (max-width: 749px) {
    .n90-footer { padding-top: {{ pt | at_most: 64 }}px; padding-bottom: {{ pb | at_most: 40 }}px; }
  }

  /* ── Main Grid ── */
  .n90-footer__grid {
    display: grid;
    grid-template-columns: 1.5fr repeat(3, 1fr) 1.5fr;
    gap: 48px;
    margin-bottom: 80px;
  }
  @media screen and (max-width: 1023px) {
    .n90-footer__grid {
      grid-template-columns: repeat(3, 1fr);
      gap: 40px;
    }
  }
  @media screen and (max-width: 749px) {
    .n90-footer__grid {
      grid-template-columns: 1fr;
      gap: 32px;
      margin-bottom: 48px;
    }
  }

  /* ── Blocks ── */
  .n90-footer__block-title {
    font-family: 'Barlow Condensed', sans-serif;
    font-size: 16px;
    font-weight: 700;
    text-transform: uppercase;
    letter-spacing: 0.08em;
    color: var(--nn-ink);
    margin: 0 0 20px 0;
  }
  
  .n90-footer__text {
    font-size: 15px;
    color: var(--nn-muted);
    line-height: 1.6;
    margin: 0 0 16px 0;
  }
  
  /* Link Lists */
  .n90-footer__list {
    list-style: none;
    padding: 0;
    margin: 0;
    display: flex;
    flex-direction: column;
    gap: 12px;
  }
  .n90-footer__list a {
    color: var(--nn-muted);
    text-decoration: none;
    font-size: 15px;
    transition: color 0.2s ease;
  }
  .n90-footer__list a:hover {
    color: var(--nn-accent);
  }

  /* Mobile Accordions */
  @media screen and (max-width: 749px) {
    .n90-footer__block--link_list .n90-footer__list {
      display: none;
      padding-top: 12px;
      padding-bottom: 16px;
    }
    .n90-footer__block--link_list.is-open .n90-footer__list {
      display: flex;
    }
    .n90-footer__block--link_list .n90-footer__block-title {
      margin: 0;
      padding: 16px 0;
      border-bottom: 1px solid var(--nn-line);
      cursor: pointer;
      display: flex;
      justify-content: space-between;
      align-items: center;
    }
    .n90-footer__block--link_list .n90-footer__block-title::after {
      content: '+';
      font-size: 18px;
      font-weight: 400;
      transition: transform 0.3s ease;
    }
    .n90-footer__block--link_list.is-open .n90-footer__block-title::after {
      transform: rotate(45deg);
    }
  }

  /* Social Icons */
  .n90-footer__social {
    display: flex;
    gap: 12px;
    margin-top: 24px;
  }
  .n90-footer__social-link {
    display: flex;
    align-items: center;
    justify-content: center;
    width: 40px;
    height: 40px;
    border-radius: 50%;
    border: 1px solid var(--nn-line);
    color: var(--nn-ink);
    transition: all 0.2s ease;
  }
  .n90-footer__social-link:hover {
    background: var(--nn-ink);
    color: var(--nn-bg);
    border-color: var(--nn-ink);
  }
  .n90-footer__social-link svg {
    width: 18px;
    height: 18px;
    fill: currentColor;
  }

  /* Newsletter Block */
  .n90-footer__newsletter-form {
    display: flex;
    flex-direction: column;
    gap: 12px;
    margin-top: 8px;
  }
  .n90-footer__input {
    background: transparent;
    border: 1px solid var(--nn-line);
    color: var(--nn-ink);
    padding: 12px 16px;
    border-radius: 8px;
    font-size: 15px;
    width: 100%;
    transition: border-color 0.2s;
  }
  .n90-footer__input:focus {
    outline: none;
    border-color: var(--nn-accent);
  }
  .n90-footer__input::placeholder { color: var(--nn-muted); }
  
  .n90-footer__submit {
    background: var(--nn-accent);
    color: #0E1B33;
    font-family: 'Barlow Condensed', sans-serif;
    font-size: 15px;
    font-weight: 700;
    text-transform: uppercase;
    letter-spacing: 0.06em;
    border: none;
    border-radius: 8px;
    padding: 12px;
    cursor: pointer;
    transition: opacity 0.2s;
    width: 100%;
  }
  .n90-footer__submit:hover { opacity: 0.85; }

  /* ── Sub-Footer Utility Bar ── */
  .n90-footer__bottom {
    border-top: 1px solid var(--nn-line);
    padding-top: 32px;
    display: flex;
    justify-content: space-between;
    align-items: center;
    flex-wrap: wrap;
    gap: 24px;
  }
  @media screen and (max-width: 749px) {
    .n90-footer__bottom {
      flex-direction: column;
      align-items: flex-start;
      gap: 32px;
    }
  }

  .n90-footer__localization {
    display: flex;
    gap: 16px;
    flex-wrap: wrap;
  }
  .n90-footer__select-wrapper {
    position: relative;
  }
  .n90-footer__select {
    appearance: none;
    background: transparent;
    border: 1px solid var(--nn-line);
    color: var(--nn-ink);
    padding: 10px 32px 10px 16px;
    border-radius: 6px;
    font-size: 13px;
    font-weight: 500;
    cursor: pointer;
  }
  .n90-footer__select-wrapper svg {
    position: absolute;
    right: 12px;
    top: 50%;
    transform: translateY(-50%);
    width: 12px;
    height: 12px;
    pointer-events: none;
    color: var(--nn-ink);
  }

  .n90-footer__copyright {
    font-size: 13px;
    color: var(--nn-muted);
  }
  .n90-footer__copyright-links {
    display: inline-flex;
    gap: 16px;
    margin-left: 16px;
  }
  .n90-footer__copyright-links a {
    color: var(--nn-muted);
    text-decoration: none;
  }
  .n90-footer__copyright-links a:hover { color: var(--nn-ink); }
  @media screen and (max-width: 749px) {
    .n90-footer__copyright-links { display: block; margin-left: 0; margin-top: 12px; }
  }

  .n90-footer__payments {
    display: flex;
    gap: 8px;
    flex-wrap: wrap;
    justify-content: flex-end;
  }
  .n90-footer__payments svg {
    width: 38px;
    height: 24px;
  }
{%- endstyle -%}

<footer class="n90-footer">
  <div class="page-width">
    
    {%- comment -%}── Main Blocks ──{%- endcomment -%}
    {%- if section.blocks.size > 0 -%}
      <div class="n90-footer__grid">
        {%- for block in section.blocks -%}
          <div class="n90-footer__block n90-footer__block--{{ block.type }}" {{ block.shopify_attributes }}>
            
            {%- case block.type -%}
              {%- when 'brand' -%}
                {%- if block.settings.logo != blank -%}
                  <img src="{{ block.settings.logo | image_url: width: 300 }}" alt="{{ shop.name | escape }}" width="{{ block.settings.logo_width }}" style="max-width:100%; height:auto; margin-bottom: 24px;">
                {%- else -%}
                  <h2 class="n90-footer__block-title" style="font-size:24px; margin-bottom:24px;">{{ shop.name }}</h2>
                {%- endif -%}
                
                {%- if block.settings.text != blank -%}
                  <div class="n90-footer__text">{{ block.settings.text }}</div>
                {%- endif -%}
                
                {%- if block.settings.show_social -%}
                  <ul class="n90-footer__social">
                    {%- if settings.social_instagram_link != blank -%}<li><a href="{{ settings.social_instagram_link }}" class="n90-footer__social-link" aria-label="Instagram">{% render 'icon-instagram' %}</a></li>{%- endif -%}
                    {%- if settings.social_tiktok_link != blank -%}<li><a href="{{ settings.social_tiktok_link }}" class="n90-footer__social-link" aria-label="TikTok">{% render 'icon-tiktok' %}</a></li>{%- endif -%}
                    {%- if settings.social_youtube_link != blank -%}<li><a href="{{ settings.social_youtube_link }}" class="n90-footer__social-link" aria-label="YouTube">{% render 'icon-youtube' %}</a></li>{%- endif -%}
                    {%- if settings.social_twitter_link != blank -%}<li><a href="{{ settings.social_twitter_link }}" class="n90-footer__social-link" aria-label="X (Twitter)">{% render 'icon-twitter' %}</a></li>{%- endif -%}
                  </ul>
                {%- endif -%}

              {%- when 'link_list' -%}
                {%- if block.settings.heading != blank -%}
                  <h3 class="n90-footer__block-title">{{ block.settings.heading | escape }}</h3>
                {%- endif -%}
                {%- if block.settings.menu != blank -%}
                  <ul class="n90-footer__list">
                    {%- for link in block.settings.menu.links -%}
                      <li><a href="{{ link.url }}">{{ link.title }}</a></li>
                    {%- endfor -%}
                  </ul>
                {%- endif -%}

              {%- when 'text_block' -%}
                {%- if block.settings.heading != blank -%}
                  <h3 class="n90-footer__block-title">{{ block.settings.heading | escape }}</h3>
                {%- endif -%}
                <div class="n90-footer__text">{{ block.settings.text }}</div>

              {%- when 'newsletter' -%}
                {%- if block.settings.heading != blank -%}
                  <h3 class="n90-footer__block-title">{{ block.settings.heading | escape }}</h3>
                {%- endif -%}
                {%- if block.settings.text != blank -%}
                  <div class="n90-footer__text">{{ block.settings.text }}</div>
                {%- endif -%}
                
                {% form 'customer', class: 'n90-footer__newsletter-form' %}
                  <input type="hidden" name="contact[tags]" value="newsletter">
                  <input type="email" name="contact[email]" class="n90-footer__input" placeholder="Email address" required>
                  <button type="submit" class="n90-footer__submit">Subscribe</button>
                  {%- if form.posted_successfully? -%}
                    <p style="color:var(--nn-accent); font-size:13px; margin:0;">Thanks for subscribing!</p>
                  {%- elsif form.errors -%}
                    <p style="color:#FF4D4D; font-size:13px; margin:0;">{{ form.errors | default_errors }}</p>
                  {%- endif -%}
                {% endform %}

            {%- endcase -%}
          </div>
        {%- endfor -%}
      </div>
    {%- endif -%}

    {%- comment -%}── Sub-Footer ──{%- endcomment -%}
    <div class="n90-footer__bottom">
      
      {%- comment -%}Localization (Currency/Country + Language){%- endcomment -%}
      <div class="n90-footer__localization">
        {%- if section.settings.enable_country_selector and localization.available_countries.size > 1 -%}
          <div class="n90-footer__select-wrapper">
            {% form 'localization', id: 'FooterCountryForm' %}
              <select name="country_code" class="n90-footer__select" onchange="this.form.submit()">
                {%- for country in localization.available_countries -%}
                  <option value="{{ country.iso_code }}" {%- if country.iso_code == localization.country.iso_code %} selected{% endif %}>
                    {{ country.name }} ({{ country.currency.iso_code }} {{ country.currency.symbol }})
                  </option>
                {%- endfor -%}
              </select>
              <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M6 9l6 6 6-6"/></svg>
            {% endform %}
          </div>
        {%- endif -%}
        
        {%- if section.settings.enable_language_selector and localization.available_languages.size > 1 -%}
          <div class="n90-footer__select-wrapper">
            {% form 'localization', id: 'FooterLanguageForm' %}
              <select name="locale_code" class="n90-footer__select" onchange="this.form.submit()">
                {%- for language in localization.available_languages -%}
                  <option value="{{ language.iso_code }}" {%- if language.iso_code == localization.language.iso_code %} selected{% endif %}>
                    {{ language.endonym_name | capitalize }}
                  </option>
                {%- endfor -%}
              </select>
              <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M6 9l6 6 6-6"/></svg>
            {% endform %}
          </div>
        {%- endif -%}
      </div>

      {%- comment -%}Copyright & Policies{%- endcomment -%}
      <div class="n90-footer__copyright">
        &copy; {{ 'now' | date: "%Y" }} {{ shop.name }}. All rights reserved.
        {%- if shop.policies != blank -%}
          <div class="n90-footer__copyright-links">
            {%- for policy in shop.policies -%}
              <a href="{{ policy.url }}">{{ policy.title }}</a>
            {%- endfor -%}
          </div>
        {%- endif -%}
      </div>

      {%- comment -%}Payment Badges{%- endcomment -%}
      {%- if section.settings.show_payment_icons -%}
        <div class="n90-footer__payments">
          {%- for type in shop.enabled_payment_types -%}
            {{ type | payment_type_svg_tag: class: 'icon icon--full-color' }}
          {%- endfor -%}
        </div>
      {%- endif -%}
      
    </div>
  </div>
</footer>

<script>
  /* Mobile Accordion Toggle for Link Lists */
  document.querySelectorAll('.n90-footer__block--link_list .n90-footer__block-title').forEach(function(title) {
    title.addEventListener('click', function() {
      if(window.innerWidth <= 749) {
        this.parentElement.classList.toggle('is-open');
      }
    });
  });
</script>

{% schema %}
{
  "name": "Footer",
  "settings": [
    { "type": "header", "content": "Colors" },
    { "type": "color", "id": "color_background", "label": "Background", "default": "#0E1B33" },
    { "type": "color", "id": "color_text", "label": "Text", "default": "#FFFFFF" },
    { "type": "color", "id": "color_muted", "label": "Muted Text", "default": "#8E9DB4" },
    { "type": "color", "id": "color_accent", "label": "Accent", "default": "#D4FF3A" },
    { "type": "color", "id": "color_line", "label": "Lines", "default": "rgba(255,255,255,0.15)" },
    { "type": "header", "content": "Spacing" },
    { "type": "range", "id": "padding_top", "label": "Padding top", "min": 0, "max": 160, "step": 8, "unit": "px", "default": 80 },
    { "type": "range", "id": "padding_bottom", "label": "Padding bottom", "min": 0, "max": 160, "step": 8, "unit": "px", "default": 48 },
    { "type": "header", "content": "Utility Bar" },
    { "type": "checkbox", "id": "enable_country_selector", "label": "Enable country/region selector", "default": true },
    { "type": "checkbox", "id": "enable_language_selector", "label": "Enable language selector", "default": true },
    { "type": "checkbox", "id": "show_payment_icons", "label": "Show payment icons", "default": true }
  ],
  "blocks": [
    {
      "type": "brand",
      "name": "Brand Info",
      "limit": 1,
      "settings": [
        { "type": "image_picker", "id": "logo", "label": "Logo image" },
        { "type": "range", "id": "logo_width", "label": "Logo width", "min": 50, "max": 300, "step": 10, "unit": "px", "default": 140 },
        { "type": "richtext", "id": "text", "label": "Text", "default": "<p>Built for the full 90 minutes. Pro-grade custom teamwear designed for durability, comfort, and ultimate performance.</p>" },
        { "type": "checkbox", "id": "show_social", "label": "Show social icons", "default": true }
      ]
    },
    {
      "type": "link_list",
      "name": "Menu",
      "settings": [
        { "type": "text", "id": "heading", "label": "Heading", "default": "Quick links" },
        { "type": "link_list", "id": "menu", "label": "Menu", "default": "footer" }
      ]
    },
    {
      "type": "text_block",
      "name": "Text",
      "settings": [
        { "type": "text", "id": "heading", "label": "Heading", "default": "About Us" },
        { "type": "richtext", "id": "text", "label": "Text", "default": "<p>Share store details, promotions, or brand content with your customers.</p>" }
      ]
    },
    {
      "type": "newsletter",
      "name": "Newsletter",
      "limit": 1,
      "settings": [
        { "type": "text", "id": "heading", "label": "Heading", "default": "Match Alerts" },
        { "type": "richtext", "id": "text", "label": "Text", "default": "<p>Subscribe for exclusive drops and VIP early access.</p>" }
      ]
    }
  ],
  "presets": [
    {
      "name": "Footer",
      "blocks": [
        { "type": "brand" },
        { "type": "link_list", "settings": { "heading": "Gear" } },
        { "type": "link_list", "settings": { "heading": "Support" } },
        { "type": "newsletter", "settings": { "heading": "VIP Newsletter" } }
      ]
    }
  ]
}
{% endschema %}
