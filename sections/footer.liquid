{%- comment -%}
  sections/footer.liquid
  Nineties90 — Dark Footer Refactor
{%- endcomment -%}

<style>
  .n90-footer-wrapper {
    background-color: #0b0d0e;
    color: #ffffff;
    width: 100%;
    border-top: 1px solid rgba(255, 255, 255, 0.1);
    font-family: 'Barlow', sans-serif;
  }
  
  .n90-footer-container {
    max-width: 1280px;
    margin: 0 auto;
    padding: 60px 24px 30px;
  }

  .n90-footer-grid {
    display: grid;
    grid-template-columns: 2fr 1fr 1fr 1fr 1.5fr;
    gap: 40px;
  }
  
  @media screen and (max-width: 1024px) {
    .n90-footer-grid {
      grid-template-columns: 1fr 1fr 1fr;
    }
  }

  @media screen and (max-width: 768px) {
    .n90-footer-grid {
      grid-template-columns: 1fr;
      gap: 32px;
    }
  }

  .n90-footer-col-header {
    font-family: 'Barlow Condensed', sans-serif;
    font-weight: 700;
    text-transform: uppercase;
    letter-spacing: 0.05em;
    color: #ffffff;
    font-size: 16px;
    margin-bottom: 16px;
    display: block;
  }

  .n90-footer-link {
    color: #9ca3af;
    text-decoration: none;
    font-size: 14px;
    line-height: 2;
    display: block;
    transition: color 0.2s ease;
  }

  .n90-footer-link:hover {
    color: #ffffff;
  }

  .n90-footer-brand p {
    color: #9ca3af;
    font-size: 14px;
    line-height: 1.6;
    margin-top: 12px;
  }

  .n90-footer-brand .logo {
    font-family: 'Barlow Condensed', sans-serif;
    font-weight: 700;
    font-style: italic;
    font-size: 24px;
    letter-spacing: 0.1em;
    color: #ffffff;
    text-decoration: none;
  }

  .n90-newsletter-form {
    display: flex;
    gap: 8px;
    margin-top: 12px;
  }

  .n90-newsletter-input {
    flex-grow: 1;
    background-color: rgba(255, 255, 255, 0.05);
    border: 1px solid rgba(255, 255, 255, 0.1);
    color: #ffffff;
    padding: 10px 16px;
    border-radius: 4px;
    font-family: 'Barlow', sans-serif;
    font-size: 14px;
    outline: none;
  }

  .n90-newsletter-input::placeholder {
    color: #9ca3af;
  }

  .n90-newsletter-input:focus {
    border-color: rgba(255, 255, 255, 0.3);
  }

  .n90-newsletter-btn {
    background: var(--nn-accent, #ccff00);
    color: #000;
    font-weight: 700;
    border-radius: 4px;
    border: none;
    padding: 10px 18px;
    font-family: 'Barlow', sans-serif;
    font-size: 14px;
    cursor: pointer;
    transition: opacity 0.2s;
    white-space: nowrap;
  }

  .n90-newsletter-btn:hover {
    opacity: 0.9;
  }

  .n90-sub-footer {
    display: flex;
    justify-content: space-between;
    align-items: center;
    border-top: 1px solid rgba(255, 255, 255, 0.1);
    margin-top: 60px;
    padding-top: 24px;
    color: #9ca3af;
    font-size: 13px;
    flex-wrap: wrap;
    gap: 16px;
  }

  .n90-sub-policies {
    display: flex;
    gap: 16px;
    flex-wrap: wrap;
  }

  .n90-sub-policies a {
    color: #9ca3af;
    text-decoration: none;
    transition: color 0.2s;
  }

  .n90-sub-policies a:hover {
    color: #ffffff;
  }
</style>

<div class="n90-footer-wrapper">
  <div class="n90-footer-container">
    <div class="n90-footer-grid">
      
      {%- comment -%} 1. Brand Column {%- endcomment -%}
      <div class="n90-footer-brand">
        {%- if section.settings.logo != blank -%}
          <img src="{{ section.settings.logo | image_url: width: 300 }}" alt="{{ shop.name | escape }}" style="max-width: {{ section.settings.logo_width }}px; height: auto;">
        {%- else -%}
          <a href="/" class="logo">{{ shop.name }}</a>
        {%- endif -%}
        <p>{{ section.settings.brand_bio | escape }}</p>
      </div>

      {%- comment -%} 2. Column: Sports (or block 1) {%- endcomment -%}
      <div class="n90-footer-nav">
        {%- assign col1_block = section.blocks[0] -%}
        <span class="n90-footer-col-header">{{ col1_block.settings.heading | default: 'Sports' }}</span>
        {%- if col1_block and col1_block.settings.menu.links.size > 0 -%}
          {%- for link in col1_block.settings.menu.links -%}
            <a href="{{ link.url }}" class="n90-footer-link">{{ link.title }}</a>
          {%- endfor -%}
        {%- else -%}
          <a href="#" class="n90-footer-link">Footballs</a>
          <a href="#" class="n90-footer-link">Goalkeeper Gloves</a>
          <a href="#" class="n90-footer-link">Kits</a>
          <a href="#" class="n90-footer-link">Training Gear</a>
        {%- endif -%}
      </div>

      {%- comment -%} 3. Column: Shop (or block 2) {%- endcomment -%}
      <div class="n90-footer-nav">
        {%- assign col2_block = section.blocks[1] -%}
        <span class="n90-footer-col-header">{{ col2_block.settings.heading | default: 'Shop' }}</span>
        {%- if col2_block and col2_block.settings.menu.links.size > 0 -%}
          {%- for link in col2_block.settings.menu.links -%}
            <a href="{{ link.url }}" class="n90-footer-link">{{ link.title }}</a>
          {%- endfor -%}
        {%- else -%}
          <a href="#" class="n90-footer-link">New Drops</a>
          <a href="#" class="n90-footer-link">Best Sellers</a>
          <a href="#" class="n90-footer-link">Club Bundles</a>
        {%- endif -%}
      </div>

      {%- comment -%} 4. Column: Help (or block 3) {%- endcomment -%}
      <div class="n90-footer-nav">
        {%- assign col3_block = section.blocks[2] -%}
        <span class="n90-footer-col-header">{{ col3_block.settings.heading | default: 'Help' }}</span>
        {%- if col3_block and col3_block.settings.menu.links.size > 0 -%}
          {%- for link in col3_block.settings.menu.links -%}
            <a href="{{ link.url }}" class="n90-footer-link">{{ link.title }}</a>
          {%- endfor -%}
        {%- else -%}
          <a href="#" class="n90-footer-link">Size Guide</a>
          <a href="#" class="n90-footer-link">Shipping & Returns</a>
          <a href="#" class="n90-footer-link">Latex Care</a>
          <a href="#" class="n90-footer-link">Contact</a>
        {%- endif -%}
      </div>

      {%- comment -%} 5. Newsletter Column {%- endcomment -%}
      <div class="n90-footer-newsletter">
        <span class="n90-footer-col-header">{{ section.settings.newsletter_title | escape | default: 'Stay in the loop' }}</span>
        <p style="color: #9ca3af; font-size: 14px; margin-bottom: 12px; line-height: 1.5;">{{ section.settings.newsletter_text | escape | default: 'Get the latest drops and exclusive offers directly to your inbox.' }}</p>
        {% form 'customer' %}
          <input type="hidden" name="contact[tags]" value="newsletter">
          <div class="n90-newsletter-form">
            <input class="n90-newsletter-input" type="email" name="contact[email]" placeholder="Email address" required aria-label="Email address">
            <button type="submit" class="n90-newsletter-btn">Sign up</button>
          </div>
          {%- if form.posted_successfully? -%}
            <p style="color: var(--nn-accent, #ccff00); font-size: 13px; margin-top: 8px;">Thanks for subscribing!</p>
          {%- elsif form.errors -%}
            <p style="color: #FF4D4D; font-size: 13px; margin-top: 8px;">{{ form.errors | default_errors }}</p>
          {%- endif -%}
        {% endform %}
      </div>

    </div>

    {%- comment -%} Sub-Footer {%- endcomment -%}
    <div class="n90-sub-footer">
      <div>
        &copy; {{ 'now' | date: '%Y' }} {{ shop.name }}. All rights reserved.
      </div>
      
      <div class="n90-sub-policies">
        {%- if shop.policies != blank -%}
          {%- for policy in shop.policies -%}
            {%- if policy -%}
              <a href="{{ policy.url }}">{{ policy.title }}</a>
            {%- endif -%}
          {%- endfor -%}
        {%- else -%}
          <a href="#">Privacy Policy</a>
          <a href="#">Terms of Service</a>
          <a href="#">Refund Policy</a>
        {%- endif -%}
      </div>
    </div>

  </div>
</div>

{% schema %}
{
  "name": "Footer",
  "tag": "section",
  "settings": [
    {
      "type": "header",
      "content": "Brand"
    },
    {
      "type": "image_picker",
      "id": "logo",
      "label": "Logo image"
    },
    {
      "type": "range",
      "id": "logo_width",
      "label": "Logo width",
      "min": 50,
      "max": 300,
      "step": 10,
      "unit": "px",
      "default": 140
    },
    {
      "type": "text",
      "id": "brand_bio",
      "label": "Brand statement",
      "default": "Custom teamwear for grassroots clubs. Built for the full 90 minutes."
    },
    {
      "type": "header",
      "content": "Newsletter"
    },
    {
      "type": "text",
      "id": "newsletter_title",
      "label": "Newsletter heading",
      "default": "Match Alerts"
    },
    {
      "type": "text",
      "id": "newsletter_text",
      "label": "Newsletter text",
      "default": "Get 10% off your first order when you sign up."
    }
  ],
  "blocks": [
    {
      "type": "link_list",
      "name": "Menu column",
      "settings": [
        {
          "type": "text",
          "id": "heading",
          "label": "Column heading",
          "default": "Quick links"
        },
        {
          "type": "link_list",
          "id": "menu",
          "label": "Menu"
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "Footer",
      "blocks": [
        { "type": "link_list", "settings": { "heading": "Sports" } },
        { "type": "link_list", "settings": { "heading": "Shop" } },
        { "type": "link_list", "settings": { "heading": "Help" } }
      ]
    }
  ]
}
{% endschema %}
